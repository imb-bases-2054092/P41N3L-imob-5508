{
  "name": "FICA ImobOne",
  "short_name": "ImobOne",
  "description": "Sistema de gestão da Imobiliária Bandeirantes",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#1a2d6b",
  "theme_color": "#1a2d6b",
  "lang": "pt-BR",
  "icons": [
    { "src": "img/icone-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "img/icone-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" }
  ],
  "share_target": {
    "action": "./compartilhar",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "titulo",
      "text": "texto",
      "files": [{ "name": "arquivo", "accept": ["application/pdf", "image/*", ".pdf", ".jpg", ".jpeg", ".png"] }]
    }
  }
}
